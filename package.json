{
  "name": "geotiff-tilesource",
  "version": "2.2.0",
  "description": "A plugin tilesource for OpenSeadragon that uses geotiff.js to provide serverless access to view compatible local or remote TIFF files",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottcali/GeoTIFFTileSource.git"
  },
  "keywords": [
    "GeoTIFFTileSource",
    "TIFF",
    "GeoTIFF",
    "image",
    "raster",
    "ome",
    "zarr",
    "ozx",
    "NGFF",
    "OpenSeadragon",
    "tilesource"
  ],
  "files": [
    "dist",
    "dist-module",
    "dist-node",
    "dist-browser"
  ],
  "type": "module",
  "main": "./dist/geotiff-tilesource.min.js",
  "module": "./dist/geotiff-tilesource.mjs",
  "jsdelivr": "dist-browser/geotiff-tilesource.js",
  "unpkg": "dist-browser/geotiff-tilesource.js",
  "exports": {
    ".": {
      "import": "./dist/geotiff-tilesource.mjs",
      "require": "./dist/geotiff-tilesource.min.js",
      "browser": "./dist/geotiff-tilesource.js"
    }
  },
  "dependencies": {
    "@petamoriken/float16": "^3.9.3",
    "lerc": "^4.0.4",
    "pako": "^2.1.0",
    "parse-headers": "^2.0.2",
    "quick-lru": "^7.3.0",
    "web-worker": "^1.5.0",
    "xml-utils": "^1.10.2",
    "zstddec": "^0.2.0",
    "@zarrita/storage": "^0.1.4",
    "numcodecs": "^0.3.2",
    "ome-zarr.js": "^0.0.17",
    "zarrita": "^0.5.4"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "^24.1.0",
    "openseadragon": "^4.1.1",
    "prettier": "3.2.5",
    "rollup-plugin-license": "^3.4.0",
    "vite": "^6.0.5",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^4.0.6",
    "@babel/core": "^7.8.7",
    "@babel/plugin-transform-runtime": "^7.16.10",
    "@babel/preset-env": "^7.10.2",
    "@babel/register": "^7.8.6",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-commonjs": "^21.0.1",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "chai": "^4.2.0",
    "chai-as-promised": "^8.0.1",
    "chokidar-cli": "^3.0.0",
    "detect-node": "^2.0.4",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-plugin-import": "^2.24.2",
    "express": "^4.17.1",
    "finalhandler": "^1.1.2",
    "fs-extra": "^7.0.1",
    "jsdoc": "^3.6.4",
    "jsdoc-plugin-intersection": "^1.0.4",
    "jsdoc-plugin-typescript": "^2.0.6",
    "jshint-stylish": "^2.2.1",
    "mocha": "^7.1.0",
    "node-abort-controller": "^1.1.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.2",
    "rollup": "^2.63.0",
    "rollup-plugin-terser": "^7.0.2",
    "send-ranges": "^4.0.0",
    "serve": "^13.0.2",
    "serve-static": "^1.14.1",
    "shx": "^0.3.3",
    "typescript": "^4.5.5"
  },
  "peerDependencies": {
    "openseadragon": "^3.0.0 || ^4.0.0 || ^5.0.0"
